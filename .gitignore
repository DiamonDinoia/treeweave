/compile_commands.json
/.cache
/build*
__pycache__
*.egg-info
*.o
*.mexa64
*.mex
# The MEX binary is built in the CMake build tree. The mwrap-generated sources
# (treeweave_mex_gen.cpp, tw_*.m) are committed under bindings/matlab/generated/
# so a checkout without mwrap still builds; matlab.yml's regen-check guards them.
# Julia libraries don't commit their resolved Manifest, nor the deps.jl that
# Pkg.build("Treeweave") writes (deps/build.jl regenerates it).
bindings/julia/Treeweave/Manifest.toml
bindings/julia/Treeweave/deps/deps.jl
bindings/julia/Treeweave/deps/usr/
.claude/
/report*
.idea/
# Exhale-generated API tree + Sphinx output (regenerated by the docs build).
docs/api/
docs/_build/
# macOS metadata
.DS_Store
# Python tooling artifacts
.ruff_cache/
dist/
wheelhouse/
.venv/
venv/
# Native build artifacts
*.so
*.dylib
*.dll
*.pyd
*.node
# JS/TS binding (bindings/js): npm deps + WASM output (dist/ is already ignored above)
node_modules/
*.wasm
# Prebuilt per-platform N-API addons, assembled in CI from the build matrix
prebuilds/
# ctest output directory
Testing/
# Scratch / throwaway sources: keep local-only, never commit
*scratch*
*.scratch
scratch/
devel/*
.ccache/

# Doc figures captured from the examples at docs-build time.
docs/_generated/

# Generated on every CMake configure from VERSION + git state by
# cmake/treeweave_generate_version.cmake. Untracked so a stale copy can never be
# committed by mistake; consumers get it from the configure step, the release
# tarballs or the cxx-headers bundle, all of which run CMake first.
include/treeweave_version.h

# Scratch tree for tools/ci/docs-recipes.sh and tools/ci/install-test.sh.
_docs-recipes/
_install-test/
# The install prefix docs/guides/cmake.rst tells a developer to create in the
# checkout: PREFIX defaults to $PWD/_prefix.
_prefix/
