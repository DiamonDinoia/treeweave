PROJECT_NAME           = "@CMAKE_PROJECT_NAME@"
PROJECT_NUMBER         = "@CMAKE_PROJECT_VERSION@"
OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/docs"
# Public surface only: the C++ umbrella tree + the C ABI header. The detail/
# subtree is excluded by EXCLUDE_SYMBOLS below.
INPUT                  = "@CMAKE_SOURCE_DIR@/include/treeweave/treeweave.hpp" \
                         "@CMAKE_SOURCE_DIR@/include/treeweave/detail/tol_kind.hpp" \
                         "@CMAKE_SOURCE_DIR@/include/treeweave.h"
RECURSIVE              = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_SOURCE_DIR@"
SHOW_INCLUDE_FILES     = NO
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO
INTERNAL_DOCS          = NO
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES
HIDE_FRIEND_COMPOUNDS  = YES
EXCLUDE_SYMBOLS        = detail treeweave::detail treeweave::detail::* *::detail::* *_detail_* TREEWEAVE_*
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = TREEWEAVE_EXPORT= \
                         DOXYGEN_SHOULD_SKIP_THIS=
GENERATE_XML           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
XML_PROGRAMLISTING     = NO
CASE_SENSE_NAMES       = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
QUIET                  = YES
